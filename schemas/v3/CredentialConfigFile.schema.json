                }
              ]
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/CredentialConfigCreate/$defs/ClaimConstraints"
                }
              ]
            },
            "propertyNames": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/CredentialConfigCreate/$defs/ClaimConstraints"
                }
              ]
            },
            "not": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/CredentialConfigCreate/$defs/ClaimConstraints"
                }
              ]
            },
            "if": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/CredentialConfigCreate/$defs/ClaimConstraints"
                }
              ]
            },
            "then": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/CredentialConfigCreate/$defs/ClaimConstraints"
                }
              ]
            },
            "else": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/CredentialConfigCreate/$defs/ClaimConstraints"
                }
              ]
            },
            "unevaluatedItems": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/CredentialConfigCreate/$defs/ClaimConstraints"
                }
              ]
            },
            "unevaluatedProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/CredentialConfigCreate/$defs/ClaimConstraints"
                }
              ]
            },
            "prefixItems": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/$defs/CredentialConfigCreate/$defs/ClaimConstraints"
                  }
                ]
              }
            },
            "allOf": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/$defs/CredentialConfigCreate/$defs/ClaimConstraints"
                  }
                ]
              }
            },
            "anyOf": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "$ref": "#/$defs/CredentialConfigCreate/$defs/ClaimConstraints"
                  }
                ]
              }
            },
            "oneOf": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
