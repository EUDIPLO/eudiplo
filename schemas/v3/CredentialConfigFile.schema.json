            "default": {},
            "examples": {},
            "deprecated": {},
            "readOnly": {},
            "writeOnly": {},
            "$comment": {},
            "items": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "$ref": "#/$defs/CredentialConfigCreate/$defs/ClaimConstraints"
                }
              ]
            },
            "contains": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
