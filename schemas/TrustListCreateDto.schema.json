    "id": {
      "description": "Optional trust list id. If omitted, one may be generated.",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "description": "Optional trust list description.",
      "type": "string"
    },
    "keyChainId": {
      "description": "Optional key chain id used to sign trust list payloads.",
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "internal",
                "description": "`internal` references key chains of this tenant; `external` carries the certificates directly, as PEM or Base64 DER."
              },
              "issuerKeyChainId": {
                "type": "string",
                "minLength": 1,
                "description": "Key chain id for issuer certificate material."
              },
              "revocationKeyChainId": {
                "type": "string",
                "minLength": 1,
                "description": "Key chain id for revocation/status list certificate material."
              },
              "providerType": {
                "description": "Provider role; defaults to attestation-provider.",
                "type": "string",
                "enum": [
                  "attestation-provider",
                  "wallet-provider"
                ]
              },
              "info": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Display name of the trusted entity."
                  },
                  "lang": {
                    "description": "Optional language of the entity's name, postal address, contact and information URI: an IETF RFC 5646 language tag in lower case, for example en or de-at (ETSI TS 119 602 clause 6.1.4). Defaults to en. With another language, the list publishes these texts in that language and again under en with the same text, since every list supports English (clause 6.1.4); service names are published in English only.",
                    "type": "string",
                    "pattern": "^(?:(?:[a-z]{2,3}(?:-[a-z]{3}){0,3}|[a-z]{4,8})(?:-[a-z]{4})?(?:-(?:[a-z]{2}|[0-9]{3}))?(?:-(?:[a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(?:-[0-9a-wy-z](?:-[a-z0-9]{2,8})+)*(?:-x(?:-[a-z0-9]{1,8})+)?)$"
                  },
                  "locale": {
                    "description": "Optional locale identifier.",
                    "type": "string"
                  },
                  "uri": {
                    "description": "Optional absolute URI where relying parties find information about the entity, published as TEInformationURI. Write it as a URL parser serializes it, for example https://example.com/about with spaces percent-encoded.",
                    "type": "string",
                    "format": "uri"
                  },
                  "country": {
                    "description": "Optional country of the postal address: an ISO 3166-1 alpha-2 code in capital letters, with \"UK\" for the United Kingdom, \"EL\" for Greece and \"EU\" for the European Union (ETSI TS 119 602 clause 6.1.5). Defaults to EU.",
