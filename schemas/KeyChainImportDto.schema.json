{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "description": "Optional key chain id. If omitted, one is generated.",
      "type": "string"
    },
    "key": {
      "description": "Private key material in JWK format.",
      "type": "object",
      "properties": {
        "kty": {
          "type": "string",
          "description": "Key type (for example EC)."
        },
        "x": {
          "type": "string",
          "description": "Elliptic curve public x coordinate."
        },
        "y": {
          "type": "string",
          "description": "Elliptic curve public y coordinate."
        },
        "crv": {
          "type": "string",
          "description": "Elliptic curve name."
        },
        "d": {
          "type": "string",
          "description": "Private key value."
        },
        "alg": {
          "description": "Optional algorithm hint.",
          "type": "string"
        },
        "kid": {
          "description": "Optional key identifier.",
          "type": "string"
        }
      },
      "required": [
        "kty",
        "x",
        "y",
        "crv",
        "d"
      ],
      "additionalProperties": false
    },
    "keyPem": {
      "description": "PKCS#8 PEM-encoded EC private key material.",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "description": "Optional key chain description.",
      "type": "string"
    },
    "usageType": {
      "type": "string",
      "enum": [
        "access",
        "accessToken",
        "attestation",
        "trustList",
        "statusList",
        "federation",
        "encrypt"
      ],
      "description": "Key usage category for the imported key chain."
    },
    "type": {
      "description": "Key chain type. `standalone`: `key` is the signing key and `crt` its chain, leaf first. `internalChain`: `key` is a CA key and the last `crt` entry its CA certificate (created if `crt` is omitted); the import generates a new signing key with a certificate issued by it. Without `type`, `key` is a CA key only if `rotationPolicy.enabled` is true and `crt` is not a single self-signed certificate that is not a CA.",
      "type": "string",
      "enum": [
        "standalone",
        "internalChain"
      ]
    },
    "crt": {
      "description": "Optional certificate chain values in PEM or base64 DER.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kmsProvider": {
      "description": "Optional KMS provider id.",
      "type": "string"
    },
    "rotationPolicy": {
      "description": "Optional rotation policy for imported key chains.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable automatic rotation for imported key chains."
        },
        "intervalDays": {
          "description": "Rotation interval in days.",
          "type": "number",
          "minimum": 1,
          "maximum": 3650
        },
        "certValidityDays": {
          "description": "Certificate validity period in days.",
          "type": "number",
          "minimum": 1,
          "maximum": 3650
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "usageType"
  ],
  "additionalProperties": false,
  "$id": "./KeyChainImportDto.schema.json",
  "title": "KeyChainImportDto"
}
