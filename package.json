{
  "name": "eudiplo-workspace",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:docs": "pnpm -r build",
    "dev:client": "pnpm --filter @eudiplo/client dev",
    "dev:backend": "pnpm --filter @eudiplo/backend dev",
    "dev:docs": "pnpm run --filter @eudiplo/docs docusaurus start",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean",
    "release:dry": "set -a && source .env && set +a && npx semantic-release --dry-run 2>&1",
    "release:version": "set -a && source .env && set +a && npx semantic-release --dry-run 2>&1 | sed -n 's/.*next release version is \\([0-9]*\\.[0-9]*\\.[0-9]*\\).*/\\1/p' | head -1 || echo 'No release pending'",
    "gen:api": "pnpm exec tsx scripts/generate-schemas.ts",
    "gen:sdk": "pnpm --filter @eudiplo/sdk-core generate",
    "gen:all": "pnpm run gen:api && pnpm run gen:sdk",
    "check:env-example": "pnpm exec tsx scripts/check-env-example.ts",
    "prepare": "husky",
    "knip": "knip",
    "schemas:snapshot": "pnpm exec tsx scripts/snapshot-config-schemas.mts",
    "schemas:sync": "node scripts/sync-config-format.mjs",
    "schemas:check": "node scripts/sync-config-format.mjs --check",
    "schemas:check-history": "node scripts/check-published-schemas.mjs",
    "schemas:check-contract": "pnpm run gen:api && node --import tsx scripts/snapshot-config-schemas.mts --check"
  },
  "devDependencies": {
    "@codedependant/semantic-release-docker": "^8.0.0",
    "@noble/hashes": "^2.4.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^26.6.2",
    "@types/unzipper": "^0.10.11",
    "cross-fetch": "^4.1.0",
    "husky": "^9.1.7",
    "joi": "^18.2.9",
    "knip": "^6.37.0",
    "reflect-metadata": "^0.2.2",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "unzipper": "^0.12.5",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
