{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "editor.codeActionsOnSave": {
    "quickfix.biome": "explicit",
    "source.organizeImports.biome": "explicit",
    "source.fixAll.markdownlint": "explicit"
  },
  "files.associations": {
    "*.json": "json"
  },
  "biome.enabled": true,
  "biome.lsp.bin": "biome",
  "emmet.excludeLanguages": [
    "markdown"
  ],
  "sqltools.connections": [
    {
      "previewLimit": 50,
      "driver": "SQLite",
      "name": "eudiplo",
      "database": "./tmp/service.db"
    }
  ],
  "json.schemas": [
    {
      "fileMatch": [
        "/assets/config/*/info.json",
        "/apps/backend/test/fixtures/*/info.json"
      ],
      "url": "./schemas/TenantConfigFile.schema.json"
    },
    {
      "fileMatch": [
        "/assets/config/*/registrar*.json",
        "/apps/backend/test/fixtures/*/registrar*.json"
      ],
      "url": "./schemas/RegistrarConfigFile.schema.json"
    },
    {
      "fileMatch": [
        "/assets/config/kms.json",
        "/assets/config/*/kms.json",
        "/apps/backend/test/fixtures/kms.json",
        "/apps/backend/test/fixtures/*/kms.json"
      ],
      "url": "./schemas/KmsConfigFile.schema.json"
    },
    {
      "fileMatch": [
        "/assets/config/*/clients/*.json",
        "/apps/backend/test/fixtures/*/clients/*.json"
      ],
      "url": "./schemas/ClientConfigFile.schema.json"
    },
    {
      "fileMatch": [
        "/assets/config/*/key-chains/*.json",
        "/apps/backend/test/fixtures/*/key-chains/*.json"
      ],
      "url": "./schemas/KeyChainConfigFile.schema.json"
    },
    {
      "fileMatch": [
        "/assets/config/*/attribute-providers/*.json",
        "/apps/backend/test/fixtures/*/attribute-providers/*.json"
      ],
      "url": "./schemas/AttributeProviderConfigFile.schema.json"
    },
    {
      "fileMatch": [
        "/assets/config/*/webhook-endpoints/*.json",
        "/apps/backend/test/fixtures/*/webhook-endpoints/*.json"
      ],
      "url": "./schemas/WebhookEndpointConfigFile.schema.json"
    },
    {
      "fileMatch": [
        "/assets/config/*/issuance/issuance.json",
        "/apps/backend/test/fixtures/*/issuance/issuance.json"
      ],
      "url": "./schemas/IssuanceConfigFile.schema.json"
    },
    {
      "fileMatch": [
        "/assets/config/*/issuance/credentials/*.json",
        "/apps/backend/test/fixtures/*/issuance/credentials/*.json"
      ],
      "url": "./schemas/CredentialConfigFile.schema.json"
    },
    {
      "fileMatch": [
        "/assets/config/*/issuance/status-lists/*.json",
        "/apps/backend/test/fixtures/*/issuance/status-lists/*.json"
      ],
      "url": "./schemas/StatusListConfigFile.schema.json"
    },
    {
      "fileMatch": [
        "/assets/config/*/trust-lists/*.json",
        "/apps/backend/test/fixtures/*/trust-lists/*.json"
      ],
      "url": "./schemas/TrustListConfigFile.schema.json"
    },
    {
      "fileMatch": [
        "/assets/config/*/presentation/*.json",
        "/apps/backend/test/fixtures/*/presentation/*.json"
      ],
      "url": "./schemas/PresentationConfigFile.schema.json"
    }
  ],
  "chat.useNestedAgentsMdFiles": true,
  "npm.exclude": [
    "**/dist/**",
    "**/site/**",
    "**/tmp/**"
  ],
  "angular.enable-strict-mode-prompt": false,
  "json.schemaDownload.enable": true,
  "cSpell.words": [
    "disclosable"
  ],
  "sonarlint.connectedMode.project": {
    "connectionId": "eudiplo",
    "projectKey": "EUDIPLO_eudiplo"
  },
  "git.alwaysSignOff": true
}
