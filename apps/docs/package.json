{
  "name": "@eudiplo/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --host 127.0.0.1 --port 3003",
    "lint": "markdownlint \"docs/**/*.md\"",
    "lint:fix": "markdownlint --fix \"docs/**/*.md\"",
    "prebuild": "tsx --tsconfig ../../tsconfig.scripts.json scripts/generate-config-docs.ts && tsx --tsconfig ../../tsconfig.scripts.json scripts/generate-cli-reference.ts",
    "build": "pnpm run prebuild && docusaurus build",
    "version:release": "VERSION=${VERSION:-current}; docusaurus docs:version \"$VERSION\"",
    "pages:deploy": "CLOUDFLARE_PAGES_BRANCH=${CLOUDFLARE_PAGES_BRANCH:-main}; npx wrangler pages deploy ./build --project-name eudiplo-docs --branch \"$CLOUDFLARE_PAGES_BRANCH\" --commit-dirty=true",
    "swizzle": "docusaurus swizzle",
    "deploy": "pnpm run build && CLOUDFLARE_PAGES_BRANCH=${CLOUDFLARE_PAGES_BRANCH:-main}; npx wrangler pages deploy ./build --project-name eudiplo-docs --branch \"$CLOUDFLARE_PAGES_BRANCH\" --commit-dirty=true",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3003",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docsearch/core": "^5.0.4",
    "@docsearch/css": "^5.0.4",
    "@docsearch/modal": "^5.0.4",
    "@docsearch/sidepanel": "^5.0.4",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "dotenv": "^18.0.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.2.18",
    "markdownlint-cli": "^0.49.1",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}