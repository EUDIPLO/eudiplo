# =============================================================================
# EUDIPLO - Minimal Configuration
# =============================================================================
# Profile: minimal (default, no profile flag needed)
# Use case: Local development, quick testing, demos
# Components: SQLite database, local file storage, DB-backed key management
# =============================================================================

# Public URL - used for OAuth redirects and OIDC
PUBLIC_URL=http://localhost:3000

# Optional demo image (contains embedded demo config bootstrap)
# Pull from GHCR: EUDIPLO_IMAGE=ghcr.io/eudiplo/eudiplo-demo:latest
# Build locally: docker build --target eudiplo-demo -t eudiplo-demo:local ../..
# EUDIPLO_IMAGE=eudiplo-demo:local

# Config mount for /app/config in the eudiplo container.
# Default is a named volume when unset.
# For local config files in this repository, use:
# EUDIPLO_CONFIG_MOUNT=../../assets:/app/config
# EUDIPLO_CONFIG_MOUNT=

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
LOG_ENABLE_SESSION_LOGGER=false
LOG_SESSION_STORE=off
LOG_ENABLE_HTTP_LOGGER=false

# =============================================================================
# Authentication
# ⚠️  REQUIRED - These have no defaults, application will fail without them!
# Generate MASTER_SECRET: openssl rand -base64 32
# =============================================================================
MASTER_SECRET=your-secret-key-here-minimum-32-characters
AUTH_CLIENT_ID=your-client-id
AUTH_CLIENT_SECRET=your-client-secret

# =============================================================================
# Database: SQLite (embedded, no external dependency)
# =============================================================================
DB_TYPE=sqlite
# SQLite database file location (inside container)
# DB_DATABASE=./data/eudiplo.sqlite

# Database Migrations
# Run migrations automatically on startup (default: true)
#DB_MIGRATIONS_RUN=true
# Enable schema synchronization (default: false)
# For dev with SQLite, you can use DB_SYNCHRONIZE=true for convenience
#DB_SYNCHRONIZE=false

# =============================================================================
# Key Management: Database-backed (default)
# Other KMS providers (e.g. Vault) are configured in kms.json in CONFIG_FOLDER,
# not via environment variables. See https://docs.eudiplo.dev/operate/kms
# =============================================================================

# =============================================================================
# File Storage: Local filesystem
# =============================================================================
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/app/uploads

# =============================================================================
# Outbound URL Policy (webhooks, attribute providers, metadata imports)
# HTTP and private/loopback targets are rejected by default. Enable them when
# EUDIPLO calls services over HTTP inside the Compose network,
# e.g. a webhook at http://webhook:8787.
# =============================================================================
#OUTBOUND_URL_ALLOW_HTTP=true
#OUTBOUND_URL_ALLOW_PRIVATE_NETWORK=true
#OUTBOUND_URL_ALLOWED_HOSTS=

# =============================================================================
# Client: Subpath Configuration (optional)
# Uncomment to serve the client from a reverse proxy subpath.
# See: https://docs.eudiplo.dev/operate/tls/#serving-the-client-from-a-subpath
# =============================================================================
# CLIENT_BASE_HREF=/eudiplo-client/
