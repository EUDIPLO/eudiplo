# =============================================================================
# EUDIPLO - Full Configuration
# =============================================================================
# Profile: full (docker compose --profile full up)
# Use case: Evaluating the encryption key in Vault. The bundled Vault runs in
#           development mode and keeps everything in memory; production needs
#           a persistent Vault (or aws/azure).
# Components: PostgreSQL, RustFS (S3), HashiCorp Vault (development mode)
# =============================================================================

# Public URL - used for OAuth redirects and OIDC
PUBLIC_URL=https://eudiplo.example.com

# Config mount for /app/config in the eudiplo container.
# Default is a named volume when unset.
# For local config files in this repository, use:
# EUDIPLO_CONFIG_MOUNT=../../assets:/app/config
# EUDIPLO_CONFIG_MOUNT=

# Host address of the published ports: backend 3000, web client 4200, RustFS
# 9000/9001 and Vault 8200. Default 0.0.0.0 (all interfaces); use 127.0.0.1
# behind a reverse proxy on the same host.
# EUDIPLO_BIND_ADDRESS=127.0.0.1

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
LOG_ENABLE_SESSION_LOGGER=false
LOG_SESSION_STORE=off
LOG_ENABLE_HTTP_LOGGER=false

# =============================================================================
# Authentication
# ⚠️  MUST change these in production!
# Generate secrets: openssl rand -base64 32
# =============================================================================
MASTER_SECRET=your-production-secret-key-minimum-32-characters
AUTH_CLIENT_ID=your-client-id
AUTH_CLIENT_SECRET=your-client-secret

# Optional: Keycloak SSO instead of the built-in OAuth2 server. OIDC is the
# issuer URL of the realm. See https://docs.eudiplo.dev/operate/keycloak
# OIDC=https://keycloak.example.com/realms/eudiplo
# OIDC_CLIENT_ID=eudiplo-admin
# OIDC_CLIENT_SECRET=your-oidc-client-secret

# =============================================================================
# Database: PostgreSQL
# =============================================================================
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=eudiplo
DB_PASSWORD=changeme-very-strong-password
DB_DATABASE=eudiplo
# Enable SSL/TLS when connecting to external PostgreSQL requiring encryption
#DB_SSL=true

# Database Migrations
# Run migrations automatically on startup (default: true)
#DB_MIGRATIONS_RUN=true
# Enable schema synchronization (default: false)
# WARNING: Only use for development, use migrations in production
#DB_SYNCHRONIZE=false

# =============================================================================
# Key Management: HashiCorp Vault
# ⚠️  The bundled Vault runs in development mode: its data, including the
#     encryption key, is lost whenever the container restarts. For production,
#     use a properly configured Vault instance with persistent storage.
# See: https://developer.hashicorp.com/vault/docs/concepts/seal
# =============================================================================
# Used by ENCRYPTION_KEY_SOURCE=vault below. To use Vault as KMS provider for
# signing keys, add a kms.json to CONFIG_FOLDER with a provider of type "vault"
# ("vaultUrl": "${VAULT_ADDR}", "vaultToken": "${VAULT_TOKEN}").
# See https://docs.eudiplo.dev/operate/kms
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root

# =============================================================================
# Encryption at Rest: Key Source
# ⚠️  For production, use vault/aws/azure so key is only in RAM (not env vars)
# =============================================================================
# Options: env (default, dev only), vault, aws, azure
ENCRYPTION_KEY_SOURCE=vault
# Path to encryption key in Vault KV secrets:
VAULT_ENCRYPTION_KEY_PATH=secret/data/eudiplo/encryption-key
# Nothing creates the key, and the backend does not start without it. Create it
# once before the first start and keep a copy; after a Vault restart, write the
# same key again. A new key makes the data encrypted so far unreadable. Steps:
# https://docs.eudiplo.dev/operate/docker-compose#create-the-encryption-key-for-full
#
# --- AWS Secrets Manager (alternative) ---
# ENCRYPTION_KEY_SOURCE=aws
# AWS_REGION=us-east-1
# AWS_ENCRYPTION_SECRET_NAME=eudiplo/encryption-key
#
# --- Azure Key Vault (alternative) ---
# ENCRYPTION_KEY_SOURCE=azure
# AZURE_KEYVAULT_URL=https://myvault.vault.azure.net
# AZURE_ENCRYPTION_SECRET_NAME=eudiplo-encryption-key

# =============================================================================
# File Storage: S3 (RustFS or AWS S3)
# =============================================================================
STORAGE_DRIVER=s3
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=changeme-strong-password
S3_BUCKET=uploads
S3_FORCE_PATH_STYLE=true

# =============================================================================
# RustFS Configuration (for the RustFS container)
# =============================================================================
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=changeme-strong-password

# =============================================================================
# Telemetry (optional)
# Enable OpenTelemetry export to a collector for metrics, traces, and logs.
# See: https://docs.eudiplo.dev/operate/monitoring/
# =============================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SDK_DISABLED=false

# Grafana Deep Links (optional)
# Set GRAFANA_URL to enable deep links from the dashboard to Grafana for logs and traces.
# The datasource UIDs default to "tempo" and "loki" (matching the provisioned datasources).
# GRAFANA_URL=http://localhost:3001
# GRAFANA_DATASOURCE_TEMPO_UID=tempo
# GRAFANA_DATASOURCE_LOKI_UID=loki

# =============================================================================
# Outbound URL Policy (webhooks, attribute providers, metadata imports)
# HTTP and private/loopback targets are rejected by default. Enable them when
# EUDIPLO calls services over HTTP inside the Compose network,
# e.g. a webhook at http://webhook:8787.
# =============================================================================
#OUTBOUND_URL_ALLOW_HTTP=true
#OUTBOUND_URL_ALLOW_PRIVATE_NETWORK=true
#OUTBOUND_URL_ALLOWED_HOSTS=

# =============================================================================
# CORS for the management API (optional)
# Comma-separated origins allowed to call /api/* from a browser. Unset allows
# all origins. Protocol and public endpoints stay open to all origins.
# =============================================================================
#CORS_ORIGINS=https://console.example.com

# =============================================================================
# Web Client (optional)
# API_BASE_URL prefills the backend URL on the login page; set it to the URL
# your browser uses for the backend (default http://localhost:3000).
# CLIENT_BASE_HREF serves the client from a reverse proxy subpath.
# See: https://docs.eudiplo.dev/operate/tls/#serving-the-client-from-a-subpath
# =============================================================================
# API_BASE_URL=https://eudiplo.example.com
# CLIENT_BASE_HREF=/eudiplo-client/
