# EUDIPLO Configuration Example
# 
# For quick demo setup, you can use this file with default values.
# The application will warn you when using demo credentials.

# Public URL (used for OAuth redirects and OIDC)
PUBLIC_URL=http://eudiplo.localtest.me

# PostgreSQL Database Configuration
DB_USERNAME=eudiplo
DB_PASSWORD=changeme123
DB_DATABASE=eudiplo
# DB_HOST and DB_PORT are set in deployment (postgres:5432)

# RustFS (S3-compatible storage)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin123
S3_BUCKET=uploads
STORAGE_DRIVER=s3
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin123
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# S3_ENDPOINT is set in deployment (http://rustfs:9000)

# Application Secrets (CHANGE IN PRODUCTION!)
MASTER_SECRET=your-secret-key-here-change-in-prod-32ch

# OAuth2 Configuration (REQUIRED when not using external OIDC)
AUTH_CLIENT_ID=your-client-id
AUTH_CLIENT_SECRET=your-secure-secret

# Logging configuration
LOG_LEVEL=info

# Optional: External OIDC provider (leave empty for integrated OAuth2)
# OIDC=https://your-keycloak.example.com/realms/eudiplo
# OIDC_INTERNAL_ISSUER_URL=https://your-keycloak.example.com/realms/eudiplo
# URL the web client is served from; Keycloak sends sign-ins only there
# OIDC_UI_URL=https://console.example.com
